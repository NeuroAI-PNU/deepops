# neuroai6: cap each RTX PRO 6000 Blackwell at 300 W since 2026-11-18 (400 W since 11-14, default 600 W) for fan noise.
# Measured 2026-11-14 with both GPUs at full tensor load:
#   600 W: fans ~18,600 rpm, server 2,132 W, ~395 TFLOPS/GPU  (~73-78 dB at 1 m)
#   400 W: fans  ~7,500 rpm, server 1,140 W, ~303 TFLOPS/GPU  (77 %, ~59 dB)
#   300 W: fans  ~6,100 rpm (= idle), server 924 W, ~233 TFLOPS/GPU (59 %)
#   NOTE: the numbers above are 3.5-min runs and underestimate fans (they lag ~1-2 min behind GPU temp).
#   8-10 min steady state, one card fully loaded: 400 W -> 9-10k rpm; 300 W -> GPU 71 C, fans idle (~6,000 rpm).
# 2026-11-20: time of day via /usr/local/sbin/nvidia-power-schedule.sh (day 300 W, 21:00-08:00 400 W);
# nvidia-power-limit.timer re-runs this unit at 08:00 and 21:00. Change DAY_W/NIGHT_W below (300..600),
# then `systemctl daemon-reload && systemctl restart nvidia-power-limit`.
[Unit]
Description=Cap NVIDIA GPU power limit (fan noise)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
Environment=DAY_W=300 NIGHT_W=400
ExecStart=/usr/local/sbin/nvidia-power-schedule.sh

[Install]
WantedBy=multi-user.target
