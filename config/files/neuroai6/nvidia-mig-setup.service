# neuroai6: recreate MIG instances on both GPUs before Slurm and the GPU exporters start.
[Unit]
Description=Recreate MIG layout on both GPUs (4x 1g.24gb each)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service
Before=slurmd.service nvidia-dcgm.service docker.dcgm-exporter.service nvidia-power-limit.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nvidia-mig-setup.sh

[Install]
WantedBy=multi-user.target
